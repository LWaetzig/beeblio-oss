{
  "name": "beeblio-desktop",
  "productName": "Beeblio",
  "version": "0.1.0",
  "description": "Desktop app for the local Beeblio workspace",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE.md",
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "pnpm build && electron .",
    "dev": "pnpm build && electron . --dev"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "electron": "44.5.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
